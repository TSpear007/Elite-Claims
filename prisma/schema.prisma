generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER_SUPER_ADMIN
  ADMIN
  COMPLIANCE
  CASE_MANAGER
  RESEARCHER
  MEMBER
}

enum CaseStatus {
  NEW
  RESEARCHING
  MATCHED
  COMPLIANCE_REVIEW
  OUTREACH_APPROVED
  CONTACTED
  ENGAGED
  CLAIM_PREPARATION
  FILED
  PAID
  CLOSED
  DISQUALIFIED
}

enum ComplianceStatus {
  UNREVIEWED
  REVIEW_REQUIRED
  APPROVED
  RESTRICTED
  BLOCKED
}

enum OutreachStatus {
  DRAFT
  PENDING_COMPLIANCE
  APPROVED
  SENT
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(MEMBER)
  planCode  String   @default("FREE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     ClaimCase[] @relation("CaseOwner")
  audits    AuditLog[]
}

model StateSource {
  id               String   @id @default(cuid())
  stateCode        String
  jurisdiction     String
  agencyName       String
  sourceName       String
  sourceUrl        String
  sourceType       String
  ingestionMethod  String   @default("MANUAL")
  active           Boolean  @default(true)
  complianceStatus ComplianceStatus @default(UNREVIEWED)
  feeRuleNotes     String?
  contactRuleNotes String?
  lastReviewedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  records          SurplusRecord[]
  @@index([stateCode, active])
}

model SurplusRecord {
  id               String   @id @default(cuid())
  sourceId         String
  source            StateSource @relation(fields: [sourceId], references: [id])
  externalRecordId String?
  stateCode        String
  county            String?
  claimantName     String?
  propertyAddress  String?
  caseNumber       String?
  amountCents      BigInt
  saleDate         DateTime?
  deadlineDate     DateTime?
  rawData          Json?
  fingerprint      String   @unique
  discoveredAt     DateTime @default(now())
  updatedAt        DateTime @updatedAt
  cases            ClaimCase[]
  @@index([stateCode, amountCents])
  @@index([claimantName])
}

model ClaimCase {
  id              String   @id @default(cuid())
  recordId        String
  record          SurplusRecord @relation(fields: [recordId], references: [id])
  ownerId         String?
  owner           User?    @relation("CaseOwner", fields: [ownerId], references: [id])
  status          CaseStatus @default(NEW)
  claimantName    String?
  claimantEmail   String?
  claimantPhone   String?
  feePercent      Decimal? @db.Decimal(5,2)
  expectedFeeCents BigInt?
  recoveredCents  BigInt?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  outreach        Outreach[]
  @@index([status, updatedAt])
}

model Outreach {
  id          String   @id @default(cuid())
  caseId      String
  claimCase   ClaimCase @relation(fields: [caseId], references: [id])
  channel     String
  destination String?
  templateKey String?
  body        String
  status      OutreachStatus @default(PENDING_COMPLIANCE)
  approvedAt  DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}
